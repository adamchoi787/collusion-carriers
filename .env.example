# Spend caps in USD, enforced by testbed/agents/budget.py.
# Per-provider caps are mandatory: 0 (the default) or unset blocks that provider.
# Raise only with the user's approval.
# Optional overall cap across providers; leave unset for none.
# BUDGET_USD_TOTAL=
BUDGET_USD_DEEPSEEK=0
BUDGET_USD_MINIMAX=0
BUDGET_USD_OPENAI=0
BUDGET_USD_ANTHROPIC=0
BUDGET_USD_MOONSHOT=0
